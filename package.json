{
  "name": "h2-video-studio",
  "productName": "HÊU",
  "version": "1.1.0",
  "description": "HÊU — studio tạo video AI hàng loạt bằng Veo 3.1 và Meta Muse; Claude trên máy viết kịch bản, khóa nhân vật, kiểm tra nhất quán.",
  "author": "Hêu",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/run-tests.js",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg zip --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "vn.heu.h2videostudio",
    "productName": "HÊU",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "flow-extension/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "src/**",
      "flow-extension/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "executableName": "HEU",
      "artifactName": "HEU-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.video",
      "artifactName": "HEU-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "HÊU",
      "uninstallDisplayName": "HÊU"
    }
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0"
  }
}
